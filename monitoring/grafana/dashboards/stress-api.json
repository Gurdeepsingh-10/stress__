      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-stress"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-stress"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(stress_predict_latency_seconds_bucket[1m])))",
